{
  "$defs": {
    "IPConfiguration": {
      "additionalProperties": false,
      "properties": {
        "ip_address": {
          "title": "Ip Address",
          "type": "string"
        },
        "subnet_mask": {
          "default": "255.255.255.0",
          "title": "Subnet Mask",
          "type": "string"
        },
        "prefix_length": {
          "default": 24,
          "maximum": 32,
          "minimum": 0,
          "title": "Prefix Length",
          "type": "integer"
        },
        "gateway": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Gateway"
        }
      },
      "required": [
        "ip_address"
      ],
      "title": "IPConfiguration",
      "type": "object"
    },
    "InterfaceDefinition": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "type": {
          "default": "ethernet",
          "enum": [
            "ethernet",
            "serial",
            "console"
          ],
          "title": "Type",
          "type": "string"
        },
        "status": {
          "default": "up",
          "enum": [
            "up",
            "active",
            "down",
            "offline",
            "failed",
            "unavailable",
            "degraded"
          ],
          "title": "Status",
          "type": "string"
        },
        "bandwidth_mbps": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 1000000,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bandwidth Mbps"
        },
        "ip_configuration": {
          "anyOf": [
            {
              "$ref": "#/$defs/IPConfiguration"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "mac_address": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mac Address"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "InterfaceDefinition",
      "type": "object"
    },
    "LinkDefinition": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "source_node_id": {
          "title": "Source Node Id",
          "type": "string"
        },
        "target_node_id": {
          "title": "Target Node Id",
          "type": "string"
        },
        "source_interface_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Interface Id"
        },
        "target_interface_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Interface Id"
        },
        "cable_type": {
          "default": "straight-through",
          "enum": [
            "straight-through",
            "crossover",
            "fiber",
            "serial",
            "console"
          ],
          "title": "Cable Type",
          "type": "string"
        },
        "bandwidth_mbps": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 1000000,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bandwidth Mbps"
        },
        "delay_ms": {
          "anyOf": [
            {
              "maximum": 1000000,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Delay Ms"
        },
        "packet_loss_pct": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Packet Loss Pct"
        },
        "status": {
          "default": "active",
          "enum": [
            "active",
            "failed",
            "unavailable",
            "down",
            "offline",
            "degraded"
          ],
          "title": "Status",
          "type": "string"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        }
      },
      "required": [
        "id",
        "source_node_id",
        "target_node_id"
      ],
      "title": "LinkDefinition",
      "type": "object"
    },
    "NodeDefinition": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "hostname": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hostname"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "device_type": {
          "enum": [
            "router",
            "switch",
            "hub",
            "access_point",
            "pc",
            "server",
            "load_balancer"
          ],
          "title": "Device Type",
          "type": "string"
        },
        "role": {
          "default": "endpoint",
          "title": "Role",
          "type": "string"
        },
        "status": {
          "default": "active",
          "enum": [
            "active",
            "failed",
            "unavailable",
            "down",
            "offline",
            "degraded"
          ],
          "title": "Status",
          "type": "string"
        },
        "interfaces": {
          "items": {
            "$ref": "#/$defs/InterfaceDefinition"
          },
          "title": "Interfaces",
          "type": "array"
        },
        "resources": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Resources",
          "type": "object"
        },
        "security_zone": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Security Zone"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        }
      },
      "required": [
        "id",
        "name",
        "device_type"
      ],
      "title": "NodeDefinition",
      "type": "object"
    },
    "RoutingConfiguration": {
      "additionalProperties": false,
      "properties": {
        "static_routes": {
          "items": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          },
          "title": "Static Routes",
          "type": "array"
        },
        "default_gateway": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Default Gateway"
        }
      },
      "title": "RoutingConfiguration",
      "type": "object"
    },
    "SecurityConfiguration": {
      "additionalProperties": false,
      "properties": {
        "zone": {
          "default": "default",
          "title": "Zone",
          "type": "string"
        },
        "segmentation": {
          "items": {
            "type": "string"
          },
          "title": "Segmentation",
          "type": "array"
        },
        "firewall_rules": {
          "items": {
            "type": "string"
          },
          "title": "Firewall Rules",
          "type": "array"
        }
      },
      "title": "SecurityConfiguration",
      "type": "object"
    },
    "SimulationConfiguration": {
      "additionalProperties": false,
      "properties": {
        "traffic_profile": {
          "default": "baseline",
          "title": "Traffic Profile",
          "type": "string"
        },
        "scenario_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scenario Id"
        },
        "experiment_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Experiment Id"
        },
        "duration_seconds": {
          "default": 300,
          "maximum": 86400,
          "minimum": 1,
          "title": "Duration Seconds",
          "type": "integer"
        }
      },
      "title": "SimulationConfiguration",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "directed": {
      "const": false,
      "default": false,
      "title": "Directed",
      "type": "boolean"
    },
    "id": {
      "default": "unsaved",
      "title": "Id",
      "type": "string"
    },
    "version": {
      "default": "1.0",
      "title": "Version",
      "type": "string"
    },
    "owner_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Owner Id"
    },
    "created_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Created At"
    },
    "updated_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Updated At"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "description": {
      "default": "",
      "title": "Description",
      "type": "string"
    },
    "nodes": {
      "items": {
        "$ref": "#/$defs/NodeDefinition"
      },
      "maxItems": 500,
      "title": "Nodes",
      "type": "array"
    },
    "links": {
      "items": {
        "$ref": "#/$defs/LinkDefinition"
      },
      "maxItems": 2000,
      "title": "Links",
      "type": "array"
    },
    "routing": {
      "$ref": "#/$defs/RoutingConfiguration"
    },
    "security": {
      "$ref": "#/$defs/SecurityConfiguration"
    },
    "simulation": {
      "$ref": "#/$defs/SimulationConfiguration"
    },
    "metadata": {
      "additionalProperties": true,
      "title": "Metadata",
      "type": "object"
    }
  },
  "required": [
    "name",
    "nodes"
  ],
  "title": "NetworkDefinition",
  "type": "object"
}

# Browser-safe Supabase project values, for existing authenticated UI.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-public-project-key
# Vite proxies /api locally. Only set for a separately hosted production API.
VITE_API_URL=
# Backend authenticated persistence (optional for /api/analysis/*).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-public-project-key
# Optional server-only chat-completion provider. Never use a VITE_ prefix.
# Provider content must be JSON with explanation and evidence claims; see docs/optimization-decision-milestones.md.
ASSISTANT_URL=
ASSISTANT_MODEL=
ASSISTANT_API_KEY=
